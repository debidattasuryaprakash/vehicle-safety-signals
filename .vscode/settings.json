{
  // This folder syncs to iCloud Drive, which keeps touching file metadata.
  // Live Server treats every touch as an edit and reloads the page, so it
  // reloads forever. Serve only the dashboard and never auto-reload; refresh
  // the browser yourself after editing. `make serve` is the alternative.
  "liveServer.settings.root": "/dashboard",
  "liveServer.settings.ignoreFiles": ["**"]
}
